# OpenAI-compatible chat endpoint. Set the model ID accepted by your provider.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Optional independent judge. Empty values inherit the controller configuration.
JUDGE_API_KEY=
JUDGE_BASE_URL=
JUDGE_MODEL=

# PostgreSQL with pgvector; tables must already contain the scholarly data.
PGHOST=localhost
PGPORT=5432
PGDATABASE=mmcot
PGUSER=mmcot
PGPASSWORD=
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=10

# Must match the encoder used to create the stored embeddings (768 dimensions).
EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2
